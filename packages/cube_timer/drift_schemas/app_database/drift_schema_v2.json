  "fixed_sql": [
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL, \"inspection_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"inspection_enabled\" IN (0, 1)), \"inspect_duration\" INTEGER NOT NULL DEFAULT 15, \"alert_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"alert_enabled\" IN (0, 1)), \"alert_types\" TEXT NOT NULL DEFAULT 'text,vibration', \"locale\" TEXT NULL, \"cube_color_u\" INTEGER NOT NULL DEFAULT 4294967295, \"cube_color_r\" INTEGER NOT NULL DEFAULT 4293815147, \"cube_color_f\" INTEGER NOT NULL DEFAULT 4278255487, \"cube_color_d\" INTEGER NOT NULL DEFAULT 4294967040, \"cube_color_l\" INTEGER NOT NULL DEFAULT 4294951229, \"cube_color_b\" INTEGER NOT NULL DEFAULT 4280193279, \"pyraminx_color_u\" INTEGER NOT NULL DEFAULT 4294967040, \"pyraminx_color_b\" INTEGER NOT NULL DEFAULT 4278255487, \"pyraminx_color_r\" INTEGER NOT NULL DEFAULT 4293815147, \"pyraminx_color_l\" INTEGER NOT NULL DEFAULT 4280193279, \"clock_color_front\" INTEGER NOT NULL DEFAULT 4292081151, \"clock_color_back\" INTEGER NOT NULL DEFAULT 4282352383, \"timer_pressed_color\" INTEGER NOT NULL DEFAULT 4294932857, \"timer_holding_color\" INTEGER NOT NULL DEFAULT 4294967161, \"timer_accept_color\" INTEGER NOT NULL DEFAULT 4280345188, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_state\" (\"id\" INTEGER NOT NULL, \"puzzle\" TEXT NOT NULL DEFAULT '333', \"session\" TEXT NOT NULL DEFAULT 'default' REFERENCES sessions (id), \"show_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"show_archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"records\" (\"id\" TEXT NOT NULL, \"puzzle\" TEXT NOT NULL, \"session\" TEXT NOT NULL REFERENCES sessions (id), \"scramble\" TEXT NOT NULL, \"time\" INTEGER NOT NULL, \"datetime\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"penalty\" TEXT NOT NULL, \"comment\" TEXT NULL, \"deleted_at\" INTEGER NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "records_session_puzzle",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX records_session_puzzle ON records (session, puzzle, datetime)"
        }
      ]
    }
